# Laravel application name.
APP_NAME=Laravel
# Application environment.
APP_ENV=local
# Generate once with Laravel; do not copy the APP_KEY from this example.
APP_KEY=
# Enable detailed errors only in development.
APP_DEBUG=true
# Public URL; update to match APP_PORT in the root .env.
APP_URL=http://localhost
# Default application language.
APP_LOCALE=en
# Fallback language.
APP_FALLBACK_LOCALE=en
# Faker data locale.
APP_FAKER_LOCALE=en_US
# Maintenance mode storage driver.
APP_MAINTENANCE_DRIVER=file
# Password hashing work factor.
BCRYPT_ROUNDS=12
# Application log channel.
LOG_CHANNEL=stack
# Log stack configuration.
LOG_STACK=single
# Channel for deprecation messages.
LOG_DEPRECATIONS_CHANNEL=null
# Minimum log severity.
LOG_LEVEL=debug
# Laravel database driver.
DB_CONNECTION=mysql
# Compose MySQL service name.
DB_HOST=mysql
# Internal MySQL container port.
DB_PORT=3306
# Database name; must match the root .env.
DB_DATABASE=storytoscene
# MySQL application user; must match the root .env.
DB_USERNAME=storytosceneai
# MySQL application password; must match the root .env.
DB_PASSWORD=change-me
# Session storage driver.
SESSION_DRIVER=database
# Session lifetime in minutes.
SESSION_LIFETIME=120
# Encrypt session data.
SESSION_ENCRYPT=false
# Session cookie path.
SESSION_PATH=/
# Session cookie domain.
SESSION_DOMAIN=null
# Broadcast driver.
BROADCAST_CONNECTION=log
# Default filesystem disk.
FILESYSTEM_DISK=local
# Queue driver.
QUEUE_CONNECTION=database
# Cache driver.
CACHE_STORE=database
# Memcached service host when used.
MEMCACHED_HOST=127.0.0.1
# Redis client implementation.
REDIS_CLIENT=phpredis
# Compose Redis service name.
REDIS_HOST=redis
# Redis password, or null when authentication is disabled.
REDIS_PASSWORD=null
# Internal Redis container port.
REDIS_PORT=6379
# Outgoing mail driver.
MAIL_MAILER=log
# Mail transport scheme.
MAIL_SCHEME=null
# Mail service host.
MAIL_HOST=127.0.0.1
# Mail service port.
MAIL_PORT=2525
# Mail service username.
MAIL_USERNAME=null
# Mail service password.
MAIL_PASSWORD=null
# Sender email address.
MAIL_FROM_ADDRESS="hello@example.com"
# Sender display name.
MAIL_FROM_NAME="${APP_NAME}"
# AWS access key, if AWS services are used.
AWS_ACCESS_KEY_ID=
# AWS secret key, if AWS services are used.
AWS_SECRET_ACCESS_KEY=
# AWS region.
AWS_DEFAULT_REGION=us-east-1
# AWS bucket name.
AWS_BUCKET=
# Use path-style S3 endpoint URLs.
AWS_USE_PATH_STYLE_ENDPOINT=false
# Frontend application name exposed through Vite.
VITE_APP_NAME="${APP_NAME}"
