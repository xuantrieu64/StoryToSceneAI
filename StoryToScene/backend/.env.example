# APP_NAME=StoryToScene
# APP_ENV=local
# APP_KEY=
# APP_DEBUG=true
# APP_URL=http://localhost    # nếu đổi APP_PORT=8080 thì: http://localhost:8080

# APP_LOCALE=en
# APP_FALLBACK_LOCALE=en
# APP_FAKER_LOCALE=en_US

# APP_MAINTENANCE_DRIVER=file
# BCRYPT_ROUNDS=12

# LOG_CHANNEL=stack
# LOG_STACK=single
# LOG_DEPRECATIONS_CHANNEL=null
# LOG_LEVEL=debug

# # --- Database: PHẢI khớp root .env ---
# DB_CONNECTION=mysql                         
# DB_HOST=mysql                               # = tên service "mysql" trong compose (KHÔNG phải localhost)
# DB_PORT=3306                                # port TRONG mạng Docker, luôn là 3306 (KHÔNG phải DB_FORWARD_PORT)
# DB_DATABASE=myapp                    # = DB_DATABASE ở root
# DB_USERNAME=myuser                  # = DB_USERNAME ở root
# DB_PASSWORD=password                 # = DB_PASSWORD ở root


# # --- Redis: = tên service "redis" ---
# REDIS_CLIENT=phpredis
# REDIS_HOST=redis
# REDIS_PASSWORD=null
# REDIS_PORT=6379

# # --- Dùng Redis cho queue/cache/session ---
# QUEUE_CONNECTION=redis           # service "queue" chạy queue:work nên nên dùng redis
# CACHE_STORE=redis
# SESSION_DRIVER=redis

# # --- CORS / Sanctum (nếu frontend gọi API) ---
# SANCTUM_STATEFUL_DOMAINS=localhost
# FRONTEND_URL=http://localhost