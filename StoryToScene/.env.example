# Compose project name; use storytosceneai for this development stack.
COMPOSE_PROJECT_NAME=storytosceneai
# Host port for nginx.
APP_PORT=80
# Host port for MySQL; independent from the container port 3306.
DB_FORWARD_PORT=3306
# Database name; must match backend/.env.
DB_DATABASE=storytoscene
# MySQL application user; must match backend/.env.
DB_USERNAME=storytosceneai
# MySQL application password; must match backend/.env.
DB_PASSWORD=change-me
# MySQL root password used by the container initialization and healthcheck.
DB_ROOT_PASSWORD=change-me-too
