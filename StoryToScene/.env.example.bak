# # ============================================
# # Docker Compose
# # ============================================
# # Cổng host map vào nginx (mặc định 80)
# APP_PORT=80

# # ============================================
# # Laravel - Application
# # ============================================
# APP_NAME=MyApp
# APP_ENV=local
# APP_KEY=
# APP_DEBUG=true
# APP_URL=http://localhost

# # ============================================
# # Database (MySQL)
# # Các biến DB_DATABASE, DB_USERNAME, DB_PASSWORD, DB_ROOT_PASSWORD
# # được dùng trực tiếp trong docker-compose.yml
# # ============================================
# DB_CONNECTION=mysql
# DB_HOST=mysql
# DB_PORT=3306
# DB_DATABASE=app
# DB_USERNAME=app
# DB_PASSWORD=secret
# DB_ROOT_PASSWORD=root_secret

# # ============================================
# # Redis
# # ============================================
# REDIS_CLIENT=phpredis
# REDIS_HOST=redis
# REDIS_PASSWORD=null
# REDIS_PORT=6379

# # ============================================
# # Cache / Session / Queue
# # (queue worker chạy bằng: php artisan queue:work)
# # ============================================
# CACHE_STORE=redis
# SESSION_DRIVER=redis
# QUEUE_CONNECTION=redis

# # ============================================
# # Logging
# # ============================================
# LOG_CHANNEL=stack
# LOG_LEVEL=debug